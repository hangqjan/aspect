include $ASPECT_SOURCE_DIR/benchmarks/adjoint_time_dependent_temperature/adjoint_time_dependent_temperature_advection_dominated_alpha1.prm

set Output directory = output-adjoint-ev-sparse-k1

subsection Termination criteria
  set End step = 6
end

subsection Adjoint

  subsection Time dependent
    set Trajectory anchor spacing = 1
    set Trajectory cleanup policy = keep
    set Trajectory storage mode = stokes cached
  end
end

subsection Solver parameters
  subsection Stokes solver parameters
    set Use direct solver for Stokes system = true
  end
end
