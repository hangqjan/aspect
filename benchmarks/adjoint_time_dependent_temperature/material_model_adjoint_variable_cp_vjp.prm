# Standalone MaterialModelAdjoint VJP diagnostic for a benchmark model with
# genuinely temperature-dependent specific heat.

set Additional shared libraries = $ASPECT_SOURCE_DIR/benchmarks/adjoint_time_dependent_temperature/plugin/libadjoint_material_model.so

include $ASPECT_SOURCE_DIR/benchmarks/adjoint_time_dependent_temperature/adjoint_time_dependent_temperature_composition_real_density_av.prm

set Output directory = output-material-model-adjoint-variable-cp-vjp

subsection Adjoint

  subsection Diagnostics
    set Run material model adjoint VJP test = true
  end
end

subsection Material model
  set Model name = adjoint material model

  subsection Adjoint material model
    set Reference density = 1
    set Reference specific heat = 1
    set Reference temperature = 0
    set Thermal expansion coefficient = 1e-3
    set Specific heat temperature coefficient = 2e-3
    set Density differential for compositional field 1 = 0.2
    set Viscosity = 1
    set Thermal conductivity = 1e-6
  end
end
