# Recover the smooth van Keken initial chemical field from a terminal field
# generated by reference_forward.prm. Apart from the deliberately different
# initial chemical guess and the required adjoint controls, the physical model
# matches that reference case.

include $ASPECT_SOURCE_DIR/benchmarks/adjoint_van_keken_composition/reference_forward.prm

# The reference-only exporter remains loaded through the included reference
# input, but is removed from the inverse postprocessor list.
set Output directory             = output-adjoint-van-keken-inverse
set Nonlinear solver scheme      = single Advection, single Stokes, adjoint temperature

subsection Postprocess
  set List of postprocessors = visualization, velocity statistics, composition statistics
end

subsection Initial composition model
  subsection Function
    # Deliberately remove the cosine perturbation from the reference initial
    # interface. The reduced control recovers this field from the final target.
    set Function expression = 0.5*(1+tanh((0.2-z)/0.02))
  end
end

subsection Adjoint
  set Solve mode          = optimize
  set List of objectives  = composition field

  subsection Composition field
    set Field name         = chemical
    set Coordinate system  = cartesian
    set Observation source = file
    subsection Observation file
      set Data directory  = output-adjoint-van-keken-reference
      set Data file name  = terminal_composition.txt
    end
    subsection Weight function
      set Variable names       = x,y
      set Function expression  = 1
    end
  end

  subsection Optimization
    set Control field                   = chemical
    set Maximum iterations              = 12
    set Initial trust-region radius     = 1e-3
    set L-BFGS history size             = 3
    set Use physical temperature bounds = true
    set Output accepted controls        = true
  end
end
