include $ASPECT_SOURCE_DIR/benchmarks/adjoint_instantaneous_geoid_topography_temperature/inverse_refinement_3_base.prm
include $ASPECT_SOURCE_DIR/benchmarks/adjoint_instantaneous_geoid_topography_temperature/generated_self_gravitating_geoid_observation_refinement_3.prm

set Output directory = benchmarks/adjoint_instantaneous_geoid_topography_temperature/results/refinement-3/inverse-combined

subsection Adjoint
  set List of objectives = dynamic topography, self-gravitating geoid
  subsection Dynamic topography
    set Target topography model = file
    subsection Observation
      set Observation source = file
      set Observation format = ASPECT native
      subsection ASPECT reference
        set Output directory = benchmarks/adjoint_instantaneous_geoid_topography_temperature/results/refinement-3/reference
        set Time selection = final
        set Surface boundary = top
      end
    end
  end
  subsection Self-gravitating geoid
    # The coupled self-gravity forward calculation already includes surface
    # and CMB topography physically. The native dynamic-topography objective
    # supplies the separate spatial topography observation without counting
    # it again as a coupled spectral topography target.
    set Field weights = 0, 0, 1e16, 1e16
  end
end
