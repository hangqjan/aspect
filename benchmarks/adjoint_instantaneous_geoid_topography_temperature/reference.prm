# Synthetic steady reference for the temperature-from-surface-observation twin.
# The temperature anomaly is the target; its background-only counterpart is
# used by all inverse inputs in this directory.
include $ASPECT_SOURCE_DIR/benchmarks/adjoint_geoid_density/g5_topography_base.prm

set Output directory = benchmarks/adjoint_instantaneous_geoid_topography_temperature/results/reference

subsection Adjoint
  # This forward is an observation generator, not an adjoint calculation.
  # Clear the non-self-gravitating objective inherited from the G5 base input;
  # the self-gravitating-geoid postprocessor below is independent of it.
  set List of objectives =
end

subsection Mesh refinement
  # A deliberately small 3-D spherical-shell acceptance model. The inverse
  # has the identical realized mesh and no adaptive refinement.
  set Initial global refinement = 0
  set Time steps between mesh refinement = 0
end

subsection Material model
  subsection Simple model
    # Hold viscosity fixed so this first field inversion isolates the thermal
    # density/buoyancy pathway shared by geoid and dynamic topography.
    set Thermal viscosity exponent = 0
  end
end

subsection Postprocess
  set List of postprocessors = dynamic topography, boundary densities, self-gravitating geoid, visualization
  subsection Self-gravitating geoid
    set Minimum degree = 2
    set Maximum degree = 2
  end
end
